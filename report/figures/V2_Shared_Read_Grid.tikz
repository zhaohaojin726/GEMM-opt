\node[lbl,text width=4.5cm] at (8,5) {Shared tileB：16×64};
\node[lbl,text width=4.5cm] at (13.8,5) {本地 C 输出：64×64};
\node[lbl,text width=4.7cm] at (2.2,-0.85) {固定四行：2、18、34、50\\k 沿各行从 0 走到 15};
